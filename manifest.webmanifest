{
  "name": "Chismómetro",
  "short_name": "Chismómetro",
  "description": "¿Quién es el más chismoso del grupo? Se lee solo en tu móvil.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1a0b2e",
  "theme_color": "#1a0b2e",
  "icons": [
    { "src": "icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [{ "name": "chat", "accept": ["text/plain", "application/zip", "application/x-zip-compressed", ".txt", ".zip"] }]
    }
  }
}
